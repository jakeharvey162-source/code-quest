{
  "name": "codequest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finalize-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "predev": "node scripts/prepare-compiler.mjs",
    "prebuild": "node scripts/prepare-compiler.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@wasmsharp/core": "0.10.2",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
