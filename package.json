{
  "name": "codequest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finalize-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "predev": "node scripts/prepare-compiler.mjs && node scripts/prepare-terminal.mjs",
    "prebuild": "node scripts/prepare-compiler.mjs && node scripts/prepare-terminal.mjs",
    "preview": "vite preview",
    "test:cloud": "playwright test --config playwright.cloud.config.mjs",
    "test:community": "playwright test --config playwright.community.config.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@elevenlabs/elevenlabs-js": "2.71.0",
    "@lezer/highlight": "1.2.5",
    "@supabase/supabase-js": "2.117.3",
    "@types/three": "0.186.0",
    "@wasmsharp/core": "0.10.2",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "lucide-react": "1.55.0",
    "pyodide": "314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "skulpt": "1.2.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "typescript-browser": "npm:typescript@5.9.3",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10"
  }
}
