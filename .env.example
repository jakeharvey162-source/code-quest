# Browser-safe publishable key only. Never use a service-role or secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Vercel server only: never prefix an ElevenLabs key with VITE_.
ELEVENLABS_API_KEY=YOUR-SERVER-KEY
PUBLIC_APP_URL=https://YOUR-CODEQUEST-DEPLOYMENT.vercel.app

# Optional: disable Community WebSockets and retain visible-page polling.
# This reduces connection usage; it is not a substitute for workload testing.
VITE_COMMUNITY_REALTIME=true

# Tor uses the server-only Vercel OIDC token automatically on Vercel.
# For local/non-Vercel use, set an AI Gateway key in a private environment file:
# AI_GATEWAY_API_KEY=YOUR-SERVER-KEY
# Tor only uses the verified free model; no paid fallback is enabled.
